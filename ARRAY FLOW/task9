const staff: string[] = ["Andi", "Budi", "Citra", "Dina", "Eka"];
const sales: number[] = [500, 750, 300, 900, 450];

let highestIndex = 0;
let lowestIndex = 0;

for (let i = 1; i < sales.length; i++) {
  if (sales[i] > sales[highestIndex]) {
    highestIndex = i;
  }

  if (sales[i] < sales[lowestIndex]) {
    lowestIndex = i;
  }
}

console.log("Top Performer:", staff[highestIndex]);
console.log("Highest Sales:", sales[highestIndex]);

console.log("Lowest Performer:", staff[lowestIndex]);
console.log("Lowest Sales:", sales[lowestIndex]);