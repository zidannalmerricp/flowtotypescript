const scores: number[] = [85, 70, 95, 60, 80];

for (let i = 0; i < scores.length - 1; i++) {
  for (let j = 0; j < scores.length - 1 - i; j++) {
    if (scores[j] > scores[j + 1]) {
      let temp = scores[j];
      scores[j] = scores[j + 1];
      scores[j + 1] = temp;
    }
  }
}

console.log("Sorted Scores:", scores);