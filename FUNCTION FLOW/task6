function BMICategory(weight: number, height: number): string {
  let bmi = weight / (height * height);

  if (bmi < 18.5) {
    return "Underweight";
  } else if (bmi < 25) {
    return "Normal";
  } else if (bmi < 30) {
    return "Overweight";
  } else {
    return "Obese";
  }
}

let weight = 60;
let height = 1.7;

let bmi = weight / (height * height);
let category = BMICategory(weight, height);

console.log("BMI:", bmi.toFixed(2));
console.log("Category:", category);